# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model used for extraction (stage 04) and enrichment (stage 05).
CI_MODEL=claude-opus-5

# Effort per stage. Tuned in evals/, not by guesswork. See docs/COST_MODEL.md.
CI_EXTRACT_EFFORT=medium
CI_ENRICH_EFFORT=medium

# Hard ceiling per document. The pipeline refuses to start a stage that would
# push a document over this. Guard against a runaway agent loop.
CI_MAX_USD_PER_DOCUMENT=0.75

# --- Email intake ----------------------------------------------------------
# Gmail: use an App Password, not the account password.
CI_IMAP_HOST=imap.gmail.com
CI_IMAP_PORT=993
CI_IMAP_USER=contracts@example.com
CI_IMAP_PASSWORD=
CI_IMAP_FOLDER=INBOX
CI_IMAP_POLL_SECONDS=15

# --- Storage ---------------------------------------------------------------
CI_DATA_DIR=var
CI_DATABASE_URL=sqlite+pysqlite:///var/contract_intake.db

# --- Behaviour -------------------------------------------------------------
# Fields below this confidence never auto-approve.
CI_MIN_FIELD_CONFIDENCE=0.80
# Counterparty match below this goes to human review.
CI_MIN_VENDOR_MATCH=0.85
# Attachment size ceiling (MB) before triage rejects outright.
CI_MAX_ATTACHMENT_MB=25
